{
  "openapi": "3.1.0",
  "info": {
    "title": "AuraPix Embed Handshake API",
    "version": "0.1.0",
    "description": "Per-tenant allowed-origins configuration for embedding AuraPix in host applications. Drives the server-emitted `Content-Security-Policy: frame-ancestors` header and the documented postMessage handshake. See `docs/features/embed-handshake.md`."
  },
  "paths": {
    "/v1/tenants/{tenantId}/embed/allowed-origins": {
      "parameters": [
        {
          "name": "tenantId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" }
        }
      ],
      "get": {
        "summary": "Get the embed allow-list for a tenant",
        "description": "Returns the current list of origins permitted to iframe AuraPix for the tenant. Requires the `tenants.write` scope (the topology is sensitive).",
        "security": [{ "bearerAuth": [] }, { "hostApiKey": ["tenants.write"] }],
        "responses": {
          "200": {
            "description": "Current embed configuration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmbedConfigEnvelope" }
              }
            }
          },
          "400": {
            "description": "Invalid tenantId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "403": {
            "description": "Missing tenants.write scope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace the embed allow-list for a tenant",
        "description": "Replaces the full list of allowed embed origins. An empty list disables embedding (server responds with `frame-ancestors 'none'`).",
        "security": [{ "bearerAuth": [] }, { "hostApiKey": ["tenants.write"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmbedConfigInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated embed configuration",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmbedConfigEnvelope" }
              }
            }
          },
          "400": {
            "description": "Invalid body or tenantId",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "403": {
            "description": "Missing tenants.write scope",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenantId}/embed/csp-report": {
      "parameters": [
        {
          "name": "tenantId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" }
        }
      ],
      "post": {
        "summary": "CSP `frame-ancestors` violation report",
        "description": "Endpoint browsers POST to when a `frame-ancestors` directive blocks rendering. Body is treated as untrusted. Emits the metering event `embed.origin_blocked` on the existing bus. Intentionally unauthenticated (UAs do not attach credentials to CSP reports).",
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/csp-report": {
              "schema": { "$ref": "#/components/schemas/CspReport" }
            },
            "application/reports+json": {
              "schema": {
                "type": "array",
                "items": { "type": "object", "additionalProperties": true }
              }
            },
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "responses": {
          "204": { "description": "Acknowledged" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "hostApiKey": { "type": "apiKey", "in": "header", "name": "X-Host-API-Key" }
    },
    "schemas": {
      "EmbedConfigInput": {
        "type": "object",
        "required": ["origins"],
        "properties": {
          "origins": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "description": "Exact-match origin (scheme://host[:port]). HTTPS always; HTTP only for loopback hosts."
            }
          }
        },
        "additionalProperties": false
      },
      "EmbedConfig": {
        "type": "object",
        "required": ["tenantId", "allowedOrigins", "updatedAt"],
        "properties": {
          "tenantId": { "type": "string" },
          "allowedOrigins": {
            "type": "array",
            "items": { "type": "string" }
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "EmbedConfigEnvelope": {
        "type": "object",
        "required": ["embed"],
        "properties": {
          "embed": { "$ref": "#/components/schemas/EmbedConfig" }
        }
      },
      "AuraPixBrandingTokens": {
        "type": "object",
        "description": "Public-safe branding tokens forwarded to host pages via the `aurapix:ready` postMessage handshake (issue #187). Emitted by the server only when the tenant has any non-default branding configured — absent payload means the host should fall back to its own defaults. Contains **only public-safe** values: no API keys, no internal IDs.",
        "properties": {
          "primaryColor": { "type": "string", "description": "Hex primary brand color (e.g. `#2563eb`)." },
          "accentColor": { "type": "string", "description": "Hex accent brand color (e.g. `#7c3aed`)." },
          "logoUrl": { "type": "string", "description": "Public logo URL (typically an HTTPS asset)." },
          "fontFamily": { "type": "string", "description": "CSS `font-family` value the host can mirror in its surrounding chrome." }
        },
        "additionalProperties": false
      },
      "AuraPixReadyMessage": {
        "type": "object",
        "description": "`aurapix:ready` postMessage envelope sent by the embedded UI to the host page on mount. The shape lives in the postMessage contract — it is documented here for OpenAPI consumers generating typed clients.",
        "required": ["type", "tenantId", "version"],
        "properties": {
          "type": { "type": "string", "const": "aurapix:ready" },
          "tenantId": { "type": "string" },
          "version": { "type": "string", "description": "SemVer string of the embedded build." },
          "branding": { "$ref": "#/components/schemas/AuraPixBrandingTokens" }
        }
      },
      "CspReport": {
        "type": "object",
        "properties": {
          "csp-report": {
            "type": "object",
            "properties": {
              "document-uri": { "type": "string" },
              "violated-directive": { "type": "string" },
              "blocked-uri": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "details": { "type": ["object", "null"] }
            }
          }
        }
      }
    }
  }
}
